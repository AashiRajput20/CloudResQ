    {
      "id": 15,
      "type": "timeseries",
      "title": "Recovery time",
      "description": "Average time of successful recoveries (5-minute window).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 28,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (action) (increase(cloudresq_recovery_duration_seconds_sum[5m])) / sum by (action) (increase(cloudresq_recovery_duration_seconds_count[5m])) > 0",
          "legendFormat": "avg {{action}}",
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "points",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "always",
            "spanNulls": true,
            "lineInterpolation": "linear",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
