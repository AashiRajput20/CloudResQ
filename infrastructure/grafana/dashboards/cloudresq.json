        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, instance_name) (rate(cloudresq_request_duration_seconds_bucket[$__rate_interval])))",
