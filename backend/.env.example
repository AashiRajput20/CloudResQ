PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/cloudresq
CORS_ORIGIN=http://localhost:5173
# Docker (all optional; defaults are in config/index.js)
# DOCKER_SOCKET=//./pipe/docker_engine
# DEMO_APP_IMAGE=cloudresq-app
# DOCKER_NETWORK=cloudresq-net
# HEALTH_HOST=127.0.0.1
# Health Monitor (all optional; defaults are in config/index.js)
# HEALTH_CHECK_INTERVAL=5000
# FAILURE_THRESHOLD=3
# HEALTH_HISTORY_HOURS=24
# MONITOR_ENABLED=true
# Failure Detector (all optional; defaults are in config/index.js)
# CPU_SCALE_OUT_THRESHOLD=85
# MEMORY_SCALE_OUT_THRESHOLD=85
# LATENCY_THRESHOLD_MS=500
# CPU_SUSTAIN_SECONDS=60
# MEMORY_SUSTAIN_SECONDS=60
# REPEATED_FAILURE_COUNT=3
# REPEATED_FAILURE_WINDOW_MINUTES=10
# Decision thresholds (all optional; defaults are in config/index.js)
# MAX_RESTARTS_BEFORE_REPLACEMENT=3
# CPU_SCALE_IN_THRESHOLD=20
# MIN_REPLICAS=2
# MAX_REPLICAS=5